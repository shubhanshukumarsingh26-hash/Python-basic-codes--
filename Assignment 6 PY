import pandas as pd

# Sample DataFrame (use your own .csv/.xls file)
data = {
    'Name': ['Aman', 'Riya', 'Aman', 'Karan', None, 'Neha'],
    'Marks': [85, None, 85, 92, 78, 88],
    'City': ['Pune', 'Mumbai', 'Pune', 'Delhi', 'Pune', None]
}
df = pd.DataFrame(data)

print("Original DataFrame:\n", df)

# Data Exploration
print(df.head())
print(df.info())
print(df.describe())

# 1. Handling Missing Values
print(df.isnull().sum())
df_drop = df.dropna()  # remove rows with NA

df['Marks'] = df['Marks'].fillna(df['Marks'].mean()) # fill numeric with mean
df['Name'] = df['Name'].fillna(df['Name'].mode()[0])
df['City'] = df['City'].fillna(df['City'].mode()[0])

# 2. Handling Duplicates
print(f"Duplicates: {df.duplicated().sum()}")
df = df.drop_duplicates()

# 3. Filtering using loc[]
filtered = df.loc[df['Marks'] > 80]
print(filtered)

# 4. Remove Irrelevant using drop()
df_final = df.drop(index=2, errors='ignore')
print("Final Cleaned Data:\n", df_final)




